<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" prefWidth="1280.0" prefHeight="420.0" minWidth="720.0" minHeight="320.0"
            styleClass="app-root"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.opaleye.snackvar.HeteroController">

    <top>
        <VBox styleClass="toolbar-surface" spacing="2.0">
            <Label text="Heterozygous indel view" styleClass="app-title" />
            <Label text="The trace resolved into its two strands: the one matching the reference, and the subtracted remainder."
                   styleClass="hint" wrapText="true" />
        </VBox>
    </top>

    <center>
        <VBox spacing="10.0">
            <padding><Insets top="12.0" right="14.0" bottom="12.0" left="14.0" /></padding>

            <VBox spacing="6.0">
                <Label text="Deconvoluted alignment" styleClass="section-title" />
                <ScrollPane fx:id="resultPane" styleClass="alignment-pane" prefHeight="86.0" minHeight="60.0" />
            </VBox>

            <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                <Label text="Chromatogram" styleClass="section-title" />
                <HBox spacing="6.0" VBox.vgrow="ALWAYS">
                    <ScrollPane fx:id="tracePane" styleClass="trace-pane" HBox.hgrow="ALWAYS" fitToHeight="true" />
                    <VBox spacing="4.0">
                        <Button fx:id="zoomInButton" onAction="#handleZoomIn" text="+"
                                styleClass="icon" VBox.vgrow="ALWAYS" maxHeight="Infinity" />
                        <Button fx:id="zoomOutButton" onAction="#handleZoomOut" text="−"
                                styleClass="icon" VBox.vgrow="ALWAYS" maxHeight="Infinity" />
                    </VBox>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
